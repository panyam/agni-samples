dist/
.DS_Store
site/

# A team's own boards and every report written from them stay on this machine. house/ keeps only its
# README and the template, and make verify fails if anything else under it is tracked.
house/*
!house/README.md
!house/_template/
reports/

# Boards fetched from their publishers' own repos (remote/remote.pin) are never committed, since
# nothing grants this repo the right to redistribute them. Only the pin file is tracked.
remote/*
!remote/remote.pin
